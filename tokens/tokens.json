{
  "_comment": "Single source of truth for SetsOfLove. DESIGN_GUIDE.md and STYLE_GUIDE.md describe these values; tokens.css and every asset are generated from or checked against this file. Change a value here first, then regenerate.",
  "colour": {
    "ink":        { "hex": "#1B1D26", "role": "Primary text, dark surfaces, app icon ground" },
    "chalk":      { "hex": "#FFF6EC", "role": "Default page background, reversed wordmark" },
    "iron":       { "hex": "#4A4D5A", "role": "Secondary text, icons" },
    "plate":      { "hex": "#E8DCCD", "role": "Borders, dividers, disabled fills (never text)" },
    "coral":      { "hex": "#CC233B", "role": "Primary buttons, links and small red text" },
    "coral-deep": { "hex": "#A3182C", "role": "Pressed state, error text and borders" },
    "heart":      { "hex": "#FF2C4A", "role": "The heart in the logo; graphics and large text (24px+) only" },
    "yellow":     { "hex": "#FFC139", "role": "The flex in the logo; pending status fill and highlights (never text)" },
    "white":      { "hex": "#FFFFFF", "role": "Text on coral/ink, card surfaces" },
    "sage":       { "hex": "#2F6B4F", "role": "Success only" },
    "amber":      { "hex": "#8A5A00", "role": "Warning only" }
  },
  "illustration": {
    "skin":       { "hex": "#F2C09A", "role": "Character skin. Illustrations only" },
    "skin-light": { "hex": "#FADCC0", "role": "Character highlights. Illustrations only" },
    "skin-deep":  { "hex": "#D9976B", "role": "Character shading, neck, cheeks. Illustrations only" },
    "hair":       { "hex": "#4B2E1F", "role": "Character hair. Illustrations only" },
    "hair-light": { "hex": "#8A5A3C", "role": "Character hair highlights. Illustrations only" },
    "tan":        { "hex": "#D9A272", "role": "Character skin, warm tan. Illustrations only" },
    "tan-light":  { "hex": "#EBC096", "role": "Character highlights, warm tan. Illustrations only" },
    "tan-deep":   { "hex": "#B97B4E", "role": "Character shading, warm tan. Illustrations only" },
    "mint":       { "hex": "#CDEFE3", "role": "Illustration wall and light surfaces" },
    "mint-deep":  { "hex": "#8FD6C8", "role": "Illustration wall shading, windows and mirrors" },
    "teal":       { "hex": "#1FA38F", "role": "Illustration gym kit" },
    "sky":        { "hex": "#BFE6F2", "role": "Illustration window light" },
    "denim":      { "hex": "#4F7DB8", "role": "Illustration gym kit" },
    "olive":      { "hex": "#7D6F1C", "role": "Illustration gym kit" },
    "orange":     { "hex": "#F28C38", "role": "Illustration gym kit" }
  },
  "type": {
    "family": "DM Sans",
    "display_family": "Bricolage Grotesque",
    "fallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "weights": { "text": [400, 500, 600], "display": [700, 800] },
    "scale": {
      "caption": { "size": 12, "line": 16, "weight": 500 },
      "small":   { "size": 14, "line": 20, "weight": 400 },
      "body":    { "size": 16, "line": 24, "weight": 400 },
      "label":   { "size": 14, "line": 20, "weight": 600 },
      "h3":      { "size": 20, "line": 28, "weight": 700 },
      "h2":      { "size": 24, "line": 32, "weight": 700 },
      "h1":      { "size": 32, "line": 40, "weight": 700 },
      "display": { "size": 40, "line": 48, "weight": 800 }
    }
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "sm": 8, "md": 12, "lg": 16, "full": 9999 },
  "touch_target_min": 44,
  "logo": {
    "heart_width_ratio": 0.94,
    "flex_width_ratio": 0.437,
    "flex_width_ratio_small": 0.52,
    "lockup_height": 128
  },
  "icon": {
    "sizes": [16, 32, 48, 180, 192, 512, 1024],
    "mark_width": 0.62,
    "maskable_safe_zone": 0.8
  },
  "social": {
    "scale": 2,
    "og": { "width": 1200, "height": 630 },
    "twitter": { "width": 1200, "height": 600 }
  }
}
