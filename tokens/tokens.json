{
  "_comment": "Single source of truth for SetsOfLove. DESIGN_GUIDE.md and STYLE_GUIDE.md describe these values; tokens.css and every asset are generated from or checked against this file. Change a value here first, then regenerate.",
  "colour": {
    "ink":        { "hex": "#1B1F2A", "role": "Primary text, dark surfaces, logo body" },
    "chalk":      { "hex": "#F7F3EC", "role": "Default page background, reversed logo body" },
    "iron":       { "hex": "#4A5060", "role": "Secondary text, icons" },
    "plate":      { "hex": "#E4DED3", "role": "Borders, dividers, disabled fills (never text)" },
    "coral":      { "hex": "#C8323A", "role": "Brand accent, primary buttons, the heart" },
    "coral-deep": { "hex": "#A32630", "role": "Pressed state, error text and borders" },
    "white":      { "hex": "#FFFFFF", "role": "Text on coral/ink, card surfaces" },
    "sage":       { "hex": "#2F6B4F", "role": "Success only" },
    "amber":      { "hex": "#8A5A00", "role": "Warning only" }
  },
  "type": {
    "family": "Inter",
    "fallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "weights": [400, 500, 600, 700],
    "scale": {
      "caption": { "size": 12, "line": 16, "weight": 500 },
      "small":   { "size": 14, "line": 20, "weight": 400 },
      "body":    { "size": 16, "line": 24, "weight": 400 },
      "label":   { "size": 14, "line": 20, "weight": 600 },
      "h3":      { "size": 20, "line": 28, "weight": 600 },
      "h2":      { "size": 24, "line": 32, "weight": 700 },
      "h1":      { "size": 32, "line": 40, "weight": 700 },
      "display": { "size": 40, "line": 48, "weight": 700 }
    }
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "sm": 8, "md": 12, "lg": 16, "full": 9999 },
  "touch_target_min": 44,
  "icon": {
    "sizes": [16, 32, 48, 180, 192, 512, 1024],
    "maskable_safe_zone": 0.8
  },
  "social": {
    "scale": 2,
    "og": { "width": 1200, "height": 630 },
    "twitter": { "width": 1200, "height": 600 }
  }
}
